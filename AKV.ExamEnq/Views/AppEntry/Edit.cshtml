<script src="~/js/ViewModel/AppEntry3.js"></script>
 


<style>
    .k-tabstrip ul li.k-item, li.k-tabstrip-items {
        /*width: 212px;*/
        width: auto;
        font-size: 1.2em;
    }

    .required::after {
        content: "*";
        font-weight: bold;
        color: red;
    }
</style>


<div class="loading-wrapper">
    <div class='k-loading-image loading' style="background:center no-repeat; position: fixed; left: 0px; top: 0px;  width: 100%; height: 100%; z-index: 9999;"></div>

</div>



<div class="container">
    @*<div class="col-lg-8 col-md-8 col-sm-8">
            <div class="dividerHeading">
                <h4><span>Application Registration</span></h4>
            </div>

        </div>*@
    <div class="row">
        <div class="col-md-12">

            <div id="example">
                <div style="text-align:center">

                    <div id="profileCompleteness" data-role="progressbar"
                         data-min="0"
                         data-max="3"
                         data-bind="value: progressValue,
                            events: { start: onStart,
                                      change: onChange,
                                      complete: onComplete}"
                         style="width: 100%;height:1%"></div>
                </div>
                <div class="demo-section k-content">
                    <span>Course:</span>
                    <span style="color: deeppink" data-bind="text: coursecode"></span>
                    <br />
                    <span>Rollno:</span>
                    <span style="color:deeppink" data-bind="text: rollno"></span>
                    <br />
                    <span>Name:</span>
                    <span style="color:deeppink" data-bind="text: name"></span>
                    <br />
                    <div id="tabstrip" data-role="tabstrip" data-bind="events: { select: onSelect,show: onShow }">
                        <ul>
                            <li class="k-state-active">
                                Step1
                            </li>
                            <li>
                                Step2
                            </li>

                        </ul>

                        @{ Html.RenderPartial("_Step1Partial");}
                        @{ Html.RenderPartial("_Step2Partial");}


                        <div></div>
                    </div>

                </div>


            </div>




        </div>
    </div>
    <br />
</div>



