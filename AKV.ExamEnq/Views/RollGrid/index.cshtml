@using AKV.ExamEnq.Models;
@model RollViewModel

<h4>Enroll Application</h4>
<hr />
<style>
    div.k-edit-form-container {
        
        height: 200px;
    }
    /*input[type="text"] {
        font-size: 20px;
    }*/
    .k-window-titlebar {
        height: 30px !important;
        
    }
    div.Wrapper * {
        color: red;
    }
</style>
<div class="Wrapper">
  @*  <h5 > Last Date for Enroll Application 04/02/2022 6.00 PM </h5>*@
</div>
<table>

    <tr>
        <td style="padding:5px;">
            <label>Course:</label>
        </td>
        <td>
            @(Html.Kendo()
                 .ComboBox()
                 .HtmlAttributes(new { style = "width:350px" })
                 .Name("CrsnameName")
                  
                 .DataTextField("coursename")
                                 .DataValueField("coursecode")
                 .Filter(FilterType.Contains)

                                       //   .CascadeFrom("mroute")
              .DataSource(source =>
              {

                  source.Read(read =>
                  {
                      read.Action("GetCourses", "RollGrid");
                  });
              }).Events(e => e.Change("selectrouteclose"))

            )
        </td>
       <td>

       </td>
        <td>
            <button id="reportbutton" type="submit"   class="btn btn-success btn-sm"><strong>Report Check List </strong></button>
        </td>

    </tr>
</table>



<div>

    <div id="windowForAssign"></div>
    <button id="refresh" type="submit" class="btn btn-primary btn-sm"><strong>Refresh</strong></button>
 

    @(Html.Kendo().Grid<RollViewModel>()
    .Name("grid")
             .AutoBind(false)
    .Columns(columns =>
    {
        columns.Bound(p => p.id).Width(200).Title("id").Visible(false);
        columns.Bound(p => p.coursecode).Width(200).Title("coursecode").Visible(false);

        columns.Bound(r => r.rollno).Title("Rollno").Width(150);

        columns.Bound(r => r.name).Title("Name").Width(300);

        columns.Bound(p => p.status).Title("Status").ClientTemplate("#= getImage(data)#").Width(140);
        //  columns.Bound(c => c.sex).ClientTemplate("<img src='Logo/CW.png' height='62' width='62'/>").Width(100);

        columns.Command(command => command.Custom("Detail Edit").Click("showDetails")).Width(120).Locked(true);

        columns.Command(command => { command.Edit() ; command.Destroy(); }).Width(225).Locked(true);


    })
                      .ToolBar(toolbar => toolbar.Create())
            .Editable(editable => editable.Mode(GridEditMode.InLine))
              .Events(e => e.Edit("Edit"))
            .Pageable()
            .Sortable()
            .Filterable()
            .Scrollable()
                    .HtmlAttributes(new { style = "height:600px;" })
            .DataSource(dataSource => dataSource
                .Ajax()
                .PageSize(5)

                        .Events(events => events.Error("c_Error").RequestStart("test1").RequestEnd("test2"))

                .Model( model => { model.Id(p => p.id);

                    model.Field(p => p.id).Editable(false);
                    model.Field(p => p.status).Editable(false);
                })

                .Create(create => create.Action("RollCreate", "RollGrid"))
                        .Read(read => read.Action("ReadRoll", "RollGrid").Data("addparameter"))
                .Update(update => update.Action("Rollupdate", "RollGrid"))
                .Destroy(destory => destory.Action("RollDestroy", "RollGrid"))
            )
    )

    @using (Html.BeginForm("Index1", "RollGrid", FormMethod.Post, new { id = "example", @class = "navbar-right", target = "_blank" }))
    {
        @Html.HiddenFor(m => m.id)

    }

    @using (Html.BeginForm("RollCheckList", "RollGrid", FormMethod.Post, new { id = "report", @class = "navbar-right", target = "_blank" }))
    {
        @Html.HiddenFor(m => m.coursecode)

    }
</div>

<script type="text/javascript">
    $(document).ready(function () {
        //kendo.culture("en-US");
        
        $(".k-grid-add").parent().hide();

        var combobox = $('#CrsnameName').data('kendoComboBox');
        combobox.list.width(600);

        $("#refresh").click(function () {
          //  alert('asdf');
            $("#grid").data("kendoGrid").dataSource.read();
           // $('#grid').data('kendoGrid').refresh();
        });

        $("#reportbutton").click(function () {
             
            if ($("#CrsnameName").data("kendoComboBox").value() == "") {
                alert("Select Course");
                return;
            }
            $('#coursecode').val($("#CrsnameName").data("kendoComboBox").value());
            $('#report').submit();
        });
        

    });
    function editVisible(dataItem) {
        // hide the Edit button for the item with ProductID=1
       //  alert(dataItem.regno);
        return dataItem.regno == "" || dataItem.regno == null;
    }
    function showDetails(e) {
        e.preventDefault();
        var dataItem = this.dataItem($(e.currentTarget).closest("tr"));
        $('#id').val(dataItem.id);

        //    alert($('#guid').val());

        $('#example').submit();

    }
    function showDetails1(e) {
        e.preventDefault();

        var dataItem = this.dataItem($(e.currentTarget).closest("tr"));
      //  $('#id').val(dataItem.id);
       
        var kendoWindowAssign = $("#windowForAssign");
        var title = "Detail Edit";
        var url = "RollGrid/index1?id=" + dataItem.id;

            kendoWindowAssign.kendoWindow({
                width: "800px",
                modal: true,
                height: '600px',
                iframe: true,
                resizable: false,
                title: title,
                content: url,
                visible: false
            });

            var popup = $("#windowForAssign").data('kendoWindow');
            popup.open();
            popup.center();


    }
  
    function getImage(data) {
        var html;
       //alert(data.sex);
        if (data.status == "1") {
            html = "<img src='Logo/G.jpg' />";
        }
        else {
            html = "<img src='Logo/R.jpg' />";
        }

         


        return html;
    }

    Edit = function (e) {
        // alert($("#CrsnameName").data("kendoComboBox").value());
        //  if (e.model.isNew() && !e.model.dirty) {
        $('[name="coursecode"]').attr("readonly", true);
        if (e.model.isNew() && !e.model.dirty) {
            e.container
                .find("input[name=coursecode]") // get the input element for the field
                .val($("#CrsnameName").data("kendoComboBox").value()) // set the value
                .change(); // trigger change in order to notify the model binding
            //$("#coursecode").val($("#CrsnameName").data("kendoComboBox").value()).trigger("change");
            var grid = $('#grid').data('kendoGrid');
            grid.editable.options.model.set('coursecode', $("#CrsnameName").data("kendoComboBox").value());
        }




        if (e.model.isNew()) {
            //set options using the setOptions method

            $("#coursecode").val($("#CrsnameName").data("kendoComboBox").value()).trigger("change");
        } else {
            //set options using the setOptions method

        }
    }

    function test1(e) {

        $(".k-grid-add").parent().hide();

    }
    function test2(e) {

        $(".k-grid-add").parent().show();

    }
    function addparameter(e) {

        if ($("#CrsnameName").data("kendoComboBox").value() == "") {

            alert("Select Route");

        }
        var CB = $("#CrsnameName").data("kendoComboBox");
        var description = CB.dataItem(CB.select());
        return {


            coursecode: description.coursecode
        }
    }
    function selectrouteclose(e) {

        if ($("#CrsnameName").data("kendoComboBox").value() != "") {

            $(".k-grid-add").parent().show();

        } else {
            $(".k-grid-add").parent().hide();
        }
        var t1 = $("#CrsnameName").data().kendoComboBox.value();
        var t2 = $("#CrsnameName").data().kendoComboBox.text();

        if (t1 != t2) {

            $("#grid").data("kendoGrid").dataSource.read();
            // alert("asdf");

        }

    }
    c_Error = function (args) {

        if (args.errors) {

            var grid = $("#grid").data("kendoGrid");

            grid.one("dataBinding", function (e) {
                e.preventDefault();
                var message = "Errors:\n";
                $.each(args.errors, function (key, value) {
                    if ('errors' in value) {
                        $.each(value.errors, function () {
                            message += this + "\n";
                        });
                    }
                }); alert(message);
            });


        }


    };

</script>


 