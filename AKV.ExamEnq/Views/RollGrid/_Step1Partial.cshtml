 
<div>

    <h3>Personal Information</h3>


    <label class="required">Gender</label>
    <br />
    <input id="gender" name="Gender" required />

    <br />


    <label class="required">Category</label>
    <br />
    <input id="category" name="Category" required />


    <br />
    <label class="required">Medium</label>
    <br />
    <input id="medium" name="Medium" required />


    <br />
    <label for="mob" class="required">Mobile No.:</label>
    <br />
    <input type="text" id="mobno" style="width:280px;" name="MobileNo" data-bind="value: mobno" data-validmask-msg="Phone number is incomplete" required="required" />
    <span data-for='MobileNo' class='k-invalid-msg'></span>

    <br />

    <footer class="col-xs-12 form-group text-center">
        <button id="Step1" type="submit" style="width:100px;height:50px;" data-bind="click: Step1" class="btn btn-info btn-lg"><strong>Next</strong></button>
    </footer>
</div>