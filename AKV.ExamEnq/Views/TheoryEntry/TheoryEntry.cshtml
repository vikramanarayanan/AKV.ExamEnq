@using AKV.ExamEnq.Models;
@model MarkViewModel
@{
    ViewBag.Title = "Theory Mark Entry";
}

<h4>Theory Mark Entry</h4>


<style type="text/css">
    input::-webkit-outer-spin-button,
    input::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }

    /* Firefox */
    input[type=number] {
        -moz-appearance: textfield;
    }
</style>

<table>

    <tr>
        <td style="padding:5px;">
            <label>Course:</label>
        </td>
        <td>

            @(Html.Kendo().ComboBoxFor(m => m.coursecode).HtmlAttributes(new { style = "width:500px" })
                         .Name("CrsName")
          .Placeholder("Select Course")
              .DataTextField("coursename")
              .DataValueField("coursecode")
              .Filter(FilterType.Contains)
          .DataSource(source =>
          {

              source.Read(read =>
              {
                  read.Action("GetCourses", "RollGrid");
              });
          }).Events(e => e.Change("selectrouteclose"))
          )


        </td>
    </tr>

    <tr>

        <td style="padding:5px;">
            <label>Paper:</label>
        </td>
        <td>

            @(Html.Kendo().ComboBoxFor(m => m.pap_no).HtmlAttributes(new { style = "width:500px" })
        .Name("papname")
                      .Placeholder("Select Paper")
                  .DataTextField("papname")
                  .DataValueField("pap_no")
                          .Filter(FilterType.Contains)

              .DataSource(source =>
              {

                  source.Read(read =>
                  {
                      read.Action("GetTheoryPapers", "TheoryEntry").Data("filterCustomers");
                  })
                  .ServerFiltering(true);

              }).Enable(false)
                      .AutoBind(false)
                 .CascadeFrom("CrsName")
                 .Events(e => e.Change("selectrouteclose"))
                            )
            <script>
                function filterCustomers() {
                    return {
                        rid: $("#CrsName").val(),
                        namefilter: $("#papname").data("kendoComboBox").input.val()
                    };
                }
            </script>

        </td>
    </tr>

</table>
<div>



    @(Html.Kendo().Grid<MarkViewModel>
    ()
    .Name("grid")
    .AutoBind(false)
    .Navigatable()
    .Columns(columns =>
    {
        columns.Bound(p => p.id).Width(200).Title("ID").Visible(false);
        columns.Bound(r => r.pap_no).Title("Pap_NO").Width(50);
        columns.Bound(r => r.name).Title("NAME").Width(75);
        columns.Bound(r => r.regno).Title("Regno").Width(55);
        columns.Bound(r => r.rollno).Title("Rollno").Width(55);

        columns.Bound(r => r.ext).Title("Theory Mark").Width(50);

    })

    .Editable(editable => editable.Mode(GridEditMode.InCell))
    .Pageable()
    //   .Sortable()
    //   .Filterable()
    .Scrollable()
    .HtmlAttributes(new { style = "height:600px;width:800px; " })
    .Events(events => events
    .DataBound("databound")
    .Save("save")
    //.Navigate("onNavigate")
    //   .Save("save")

    )
    .DataSource(dataSource => dataSource
    .Ajax()
    .AutoSync(true)
    .PageSize(1000)
    .Events(events => events.Error("c_Error"))

    .Model( model => { model.Id(p => p.id);

        model.Field(p => p.id).Editable(false);
        model.Field(p => p.pap_no).Editable(false);
        model.Field(p => p.rollno).Editable(false);
        model.Field(p => p.regno).Editable(false);
        model.Field(p => p.name).Editable(false);

    })

    // .Create(create => create.Action("CustomerCreate", "Customer"))
    .Read(read => read.Action("ReadMark", "TheoryEntry").Data("addparameter"))
    .Update(update => update.Action("UpdateTheoryMark", "TheoryEntry"))
    //.Destroy(destory => destory.Action("CustomerDestroy", "Customer"))
    )
    )


</div>


<script type="text/javascript">
    var extmax = 0;

    $(document).ready(function () {

        $.extend(true, kendo.ui.validator, {
            rules: { // custom rules
                productnamevalidation: function (input, params) {
                    if (input.is("[name='ext']") && input.val() != "") {
                        input.attr("data-productnamevalidation-msg", "Max "+extmax+" Mark!");
                        return input.val() >= 0 && input.val() <= extmax;
                    }

                    return true;
                }
            },
            messages: { //custom rules messages
                productnamevalidation: function (input) {
                    // return the message text
                    return input.attr("data-val-productnamevalidation");
                }
            }
        });
    });

    function save(e) {
        lastEditIndex.row = this.tbody.children().index(e.container.parent());
        lastEditIndex.col = e.container.parent().children().index(e.container);
    }
    var lastEditIndex;
    function databound(e) {
        if (!$.isEmptyObject(lastEditIndex)) {
            var cell = this.tbody.children().eq(lastEditIndex.row+1).children().eq(lastEditIndex.col);

            this.current(cell);
            this.table.focus();
            this.editCell(cell);

        }

        lastEditIndex = {};
    }
    function addparameter(e) {

        if ($("#papname").data("kendoComboBox").value() == "") {

            alert("Select Paper");

        }
        if ($("#CrsName").data("kendoComboBox").value() == "") {

            alert("Select Course");

        }
        var CB1 = $("#CrsName").data("kendoComboBox");
        var description1 = CB1.dataItem(CB1.select());
        var CB = $("#papname").data("kendoComboBox");
        var description = CB.dataItem(CB.select());

        extmax = description.extmax;
        return {

            course: description1.coursecode,
            pap_no: description.pap_no
        }
    }
    function selectrouteclose(e) {


        var t1 = $("#papname").data().kendoComboBox.value();
        var t2 = $("#papname").data().kendoComboBox.text();

        if (t1 != t2) {

            $("#grid").data("kendoGrid").dataSource.read();
            // alert("asdf");

        }
        if (t1 == "") {
            $("#grid").data("kendoGrid").dataSource.data([]);
        }

    }
    c_Error = function (args) {

        if (args.errors) {

            var grid = $("#grid").data("kendoGrid");

            grid.one("dataBinding", function (e) {
                e.preventDefault();
                var message = "Errors:\n";
                $.each(args.errors, function (key, value) {
                    if ('errors' in value) {
                        $.each(value.errors, function () {
                            message += this + "\n";
                        });
                    }
                }); alert(message);
            });


        }


    };
</script>