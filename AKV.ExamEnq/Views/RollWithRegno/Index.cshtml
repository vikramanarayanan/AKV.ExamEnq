@using AKV.ExamEnq.Models;
@model RollViewModel

<h4>Roll [Regno Order]</h4>
<hr />

@using (Html.BeginForm("RollWithRegnoReport", "RollWithRegno", new { ReturnUrl = ViewBag.ReturnUrl,ordertag = "reg" }, FormMethod.Post, new { @class = "form-horizontal", role = "form", target = "_blank" }))
{

    <table>

        <tr>
            <td style="padding:5px;">
                <label>Course:</label>
            </td>
            <td>
                @(Html.Kendo()
                 .ComboBox()
                 .HtmlAttributes(new { style = "width:350px" })
                 .Name("CrsnameName")

                 .DataTextField("coursename")
                                 .DataValueField("coursecode")
                 .Filter(FilterType.Contains)

                                       //   .CascadeFrom("mroute")
              .DataSource(source =>
              {

                  source.Read(read =>
                  {
                      read.Action("GetCourses", "RollGrid");
                  });
              }).Events(e => e.Change("selectrouteclose"))

            )
            </td>
            <td>
            </td>
            <td>
                <button id="reportbutton" type="submit" class="btn btn-success btn-sm"><strong>Submit</strong></button>
            </td>

        </tr>
        @Html.HiddenFor(m => m.coursecode)
    </table>
}
<script type="text/javascript">
   
        function selectrouteclose(e) {

            $('#coursecode').val($("#CrsnameName").data("kendoComboBox").value());

        }
   
</script>
