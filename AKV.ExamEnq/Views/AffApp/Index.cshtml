@model AKV.ExamEnq.Models.AffAppYearVm
@{
    ViewBag.Title = "Affiliated Exam Fee";
    var paymentAllowed = Model == null || Model.showPayment;
    var fineAmt = Model != null ? Model.fine : 0;
    var isMayYear = Model != null
        && !string.IsNullOrWhiteSpace(Model.mthyr)
        && Model.mthyr.StartsWith("M", StringComparison.OrdinalIgnoreCase);
}
<style type="text/css">
    #loading {
        position: fixed;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        z-index: 9999;
        background: rgba(199,215,242,.5);
        display: none;
    }
    .aff-banner {
        width: 100%;
        height: 175px;
        object-fit: cover;
        display: block;
        margin-bottom: 10px;
    }
    .aff-logo-wrap {
        width: 50px;
        margin-left: 100px;
    }
    .aff-logo-wrap img {
        width: 50px;
        height: auto;
    }
    .aff-icici-wrap {
        width: 125px;
        margin-left: 100px;
    }
    .aff-icici-wrap img {
        width: 125px;
        height: auto;
    }
    .aff-foot {
        font-weight: bold;
        line-height: 1;
        margin: 0;
    }
    .aff-foot p {
        margin: 0;
        padding: 0;
        line-height: 1;
    }
    #TableCont table.aff-papers th:first-child,
    #TableCont table.aff-papers td:first-child,
    #TableCont table.aff-papers th:last-child,
    #TableCont table.aff-papers td:last-child {
        text-align: center !important;
        vertical-align: middle;
    }
    #TableCont table.aff-papers th:first-child,
    #TableCont table.aff-papers td:first-child {
        width: 90px;
    }
</style>

<div id="loading"></div>

<img src="~/Logo/top2.jpg" alt="Annamalai University" class="aff-banner" />

<h4>Affiliated Colleges Examination Fee Online Payment Portal Nov/Dec - 2026</h4>
<hr />

@if (TempData["AffError"] != null)
{
    <div class="alert alert-danger">@TempData["AffError"]</div>
}

<table>
    <tr>
        <td style="padding:5px;">
            <label>Regno:</label>
        </td>
        <td>
            @(Html.Kendo().TextBox()
                .Name("mregno")
                .HtmlAttributes(new { style = "width:250px", maxlength = "17" })
            )
        </td>
        <td style="padding:5px;">
            <button id="search" type="button" class="btn btn-success btn-sm"><strong>Search</strong></button>
        </td>
        <td>
            <div id="Error" style="color:red;font-size:20px;"></div>
        </td>
        <td>
            <div id="test" style="color:red;font-size:20px;"></div>
        </td>
    </tr>
</table>

<table id="stddetail" style="display:none;">
    <tr>
        <td style="padding:5px;">Collegecode:</td>
        <td id="collegecode"></td>
        <td style="padding:5px;">College Name:</td>
        <td id="collegename"></td>
    </tr>
    <tr>
        <td style="padding:5px;">Programmecode:</td>
        <td id="progcode"></td>
        <td style="padding:5px;">Programme Name:</td>
        <td id="progname"></td>
    </tr>
    <tr>
        <td style="padding:5px;">Name:</td>
        <td colspan="3" id="name"></td>
    </tr>
    <tr>
        <td style="padding:5px;">Register No/Rollno:</td>
        <td id="regno"></td>
    </tr>
    <tr>
        <td style="padding:5px;">Semester:</td>
        <td id="sem_no"></td>
    </tr>
    <tr>
        <td style="padding:5px;color:red;">Exam Fee &#8377;:</td>
        <td style="color:blue;font-size:20px;" id="demand"></td>
    </tr>
    <tr>
        <td style="padding:5px;"><img width="100" height="100" id="imgElem" /></td>
    </tr>
</table>

<div id="TableCont"></div>

@using (Html.BeginRouteForm("BankAffApp", FormMethod.Post, new { id = "step1" }))
{
    @Html.AntiForgeryToken()
    <input type="hidden" name="Regno" id="Mregno" />
    <table class="table table-bordered" style="max-width:720px;font-size:medium;margin-top:10px;">
        <tr>
            <th colspan="2" style="text-align:center;font-size:medium;">Detailed Fee Split-up</th>
        </tr>
        <tr>
            <td>Registration (85) + Marksheet (90)</td>
            <td>&#8377; 175/-</td>
        </tr>
        @if (isMayYear)
        {
            <tr>
                <td colspan="2" style="color:red;font-weight:bold;">Final Semester:</td>
            </tr>
            <tr>
                <td>Consolidate Mark Sheet (UG)</td>
                <td>&#8377; 850/-</td>
            </tr>
            <tr>
                <td>Consolidate Mark Sheet (PG)</td>
                <td>&#8377; 1000/-</td>
            </tr>
            <tr>
                <td>Provisional Fees</td>
                <td>&#8377; 550/-</td>
            </tr>
            <tr>
                <td>Degree Fees</td>
                <td>&#8377; 700/-</td>
            </tr>
        }
        @if (fineAmt > 0)
        {
            <tr>
                <td>Fine</td>
                <td>&#8377; @fineAmt /-</td>
            </tr>
        }
    </table>
    <button id="save" type="submit" class="btn btn-warning btn-lg" style="display:none;">Proceed Now</button>
    <div id="portalStopped" style="color:red;font-size:x-large;font-weight:bold;margin:15px 0;@(paymentAllowed ? "display:none;" : "")">Examination Fee Online Payment Portal Closed</div>
}

<div style="text-align:center;">
    <label>
        @*<span style="font-size:large;color:green">Last Date for Payment: 30/04/2026 without fine</span><br />
        <span style="font-size:large;color:red">Last Date for Payment : 03/05/2026 with fine (&#8377; 330)</span><br />*@
        <span style="font-size:large;color:red">Payment Failed? Please check for a receipt or acknowledgment after a few minutes. If the amount is debited from your account but no confirmation appears, please wait 24 hours and check again.</span>
    </label>
</div>
<hr />
<div class="row">
    <div class="col-md-4">
        <div class="aff-logo-wrap">
            <img src="~/Logo/CW.png" alt="Computer Wing" />
        </div>
        <div class="aff-foot">
            <p style="color:red"><strong>Controller Office Grievance Cell</strong></p>
            <p>Annamalai University</p>
            <p>Annamalai Nagar -608002</p>
            <p>Enq : 04144-238027</p>
            <p>Enq : 04144- 232282 Ext : 578</p>
            <p>Email: <a href="mailto:aucoecell2016@gmail.com">aucoecell2016@gmail.com</a></p>
        </div>
    </div>
    <div class="col-md-6">
        <div class="aff-icici-wrap">
            <img src="~/Logo/icicibank.png" alt="ICICI Bank" />
        </div>
        <div class="aff-foot">
            <p>NIL Charges for All Net Banking/Debit Card &amp; Credit Card</p>
            <p>We accept Visa, Master, Maestro and Rupay Card</p>
            <p>Powered by ICICI Bank Gateway</p>
        </div>
    </div>
</div>

@using (Html.BeginRouteForm("BankAffAppActions", new { action = "OpenReceipt" }, FormMethod.Post, new { id = "openReceipt", style = "display:none" }))
{
    @Html.AntiForgeryToken()
    <input type="hidden" name="refno" id="openReceiptRefno" />
}

@section scripts {
    <script type="text/javascript">
        $(function () {
            var paymentAllowed = @(paymentAllowed ? "true" : "false");
            var $loading = $("#loading");
            $(document).ajaxStart(function () { $loading.show(); }).ajaxStop(function () { $loading.hide(); });

            $("#step1").on("submit", function () {
                var regno = $.trim($("#Mregno").val() || $("#mregno").val());
                $("#Mregno").val(regno);
                if (!regno) {
                    $("#Error").html("Please Enter Register Number!");
                    return false;
                }
                if (regno.length > 17) {
                    $("#Error").html("Register Number maximum 17 characters.");
                    return false;
                }
            });

            $(document).on("click", ".open-receipt", function (e) {
                e.preventDefault();
                var $form = $("#openReceipt");
                var body = new FormData();
                body.append("__RequestVerificationToken", $form.find("input[name='__RequestVerificationToken']").val());
                body.append("refno", $(this).attr("data-ref"));
                $loading.show();
                $("#Error").html("");
                fetch($form.attr("action"), { method: "POST", body: body, credentials: "same-origin" })
                    .then(function (res) {
                        if (!res.ok) throw new Error();
                        var type = (res.headers.get("content-type") || "").toLowerCase();
                        if (type.indexOf("pdf") < 0) throw new Error();
                        return res.blob();
                    })
                    .then(function (blob) {
                        var url = URL.createObjectURL(blob);
                        var a = document.createElement("a");
                        a.href = url;
                        a.download = "AffExamFee.pdf";
                        document.body.appendChild(a);
                        a.click();
                        document.body.removeChild(a);
                        setTimeout(function () { URL.revokeObjectURL(url); }, 1000);
                    })
                    .catch(function () {
                        $("#Error").html("Unable to download acknowledgement.");
                    })
                    .then(function () { $loading.hide(); }, function () { $loading.hide(); });
            });

            $("#search").on("click", function () {
                var regno = $.trim($("#mregno").val());
                if (!regno) {
                    $("#Error").html("Please Enter Register Number!");
                    return;
                }
                if (regno.length > 17) {
                    $("#Error").html("Register Number maximum 17 characters.");
                    return;
                }
                $("#Error").html("");
                $("#test").empty();
                $("#save").hide();
                $("#stddetail").hide();
                $("#TableCont").empty();

                $.getJSON("@Url.RouteUrl("BankAffAppActions", new { action = "Search" })", { regno: regno })
                    .done(function (data) {
                        if (data.error) {
                            $("#Error").html(data.error);
                            return;
                        }
                        if (data.alreadyPaid && data.receipts && data.receipts.length) {
                            var ul = $("<ul/>");
                            $.each(data.receipts, function (i, item) {
                                ul.append('<h3><a href="#" class="open-receipt" data-ref="' + item.refno + '" style="color:blue">Your Payment was successfull click here for acknowledgement</a></h3>');
                            });
                            $("#test").append(ul);
                            return;
                        }

                        if (paymentAllowed && data.paymentAllowed !== false) {
                            $("#save").show();
                        }
                        $("#stddetail").show();
                        $("#progcode").html(data.coursecode);
                        $("#progname").html(data.coursename);
                        $("#collegecode").html(data.collegecode);
                        $("#collegename").html(data.collegename);
                        $("#name").html(data.name);
                        $("#regno").html(data.regno);
                        $("#sem_no").html(data.sem_no == "9" ? "Private" : data.sem_no);
                        $("#demand").html("\u20B9 " + parseInt(data.demand, 10) + "/-");
                        if (data.photo1) {
                            $("#imgElem").attr("src", "data:image/jpg;base64," + data.photo1);
                        }
                        $("#Mregno").val(data.regno);

                        var table = $("<table class='aff-papers' border='1'></table>");
                        table.append("<thead><tr><th>Semester</th><th>Course Code</th><th>Course Title</th><th>Course Fees</th></tr></thead>");
                        var tbody = $("<tbody></tbody>");
                        $.each(data.papers || [], function (i, p) {
                            tbody.append("<tr><td>" + (p.sem_no || "") + "</td><td>" + (p.pap_no || "") + "</td><td>" + (p.papname || "") + "</td><td>\u20B9 " + (p.papfee || 0) + "</td></tr>");
                        });
                        table.append(tbody);
                        $("#TableCont").append(table);
                        $("#TableCont table.aff-papers th:first-child, #TableCont table.aff-papers td:first-child, #TableCont table.aff-papers th:last-child, #TableCont table.aff-papers td:last-child").attr("align", "center");
                    })
                    .fail(function () {
                        $("#Error").html("Something went wrong!");
                    });
            });
        });
    </script>
}
